import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:media_kit/media_kit.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

import 'core/config/env_config.dart';
import 'core/error/error_handler.dart';
import 'core/theme/app_theme.dart';
import 'providers/app_router.dart';

// ⚠️ TEMPORARY ROLLBACK (checkpoint note): audio_service bootstrap has been
// temporarily removed from here. Reason: `dart.library.io` conditional
// import cannot separate Android/Windows (it is true on both platforms —
// it only separates web vs native, a known Dart SDK limitation,
// dart-lang/language#2133). Due to this wrong approach, the Windows build
// was breaking again ("Constant evaluation error" / CMake
// flutter_assemble failure).
//
// Next step will implement the correct solution (any one):
//   (a) Verify if audio_service can be platform-restricted in pubspec.yaml
//       (check if package is a federated plugin, Windows should be
//       automatically excluded — why it's not working needs diagnosis via
//       flutter pub get -v / flutter build windows full logs).
//   (b) Separate build flavors (separate entry points main_android.dart /
//       main_windows.dart for android/ and windows/, each compiles only for
//       its own platform — this is the safest and most proven pattern for
//       platform-exclusive packages).
//
// These files were already created earlier and were not rolled back:
//   - lib/core/audio/telo_play_audio_handler.dart (Android handler, intact)
//   - lib/core/audio/audio_handler_registry.dart (global handler var, intact)
//   - lib/core/audio/windows_media_service.dart (SMTC wrapper, intact)
// These three files need no changes — only the wiring method in main.dart
// (dart.library.io approach) was wrong, that will be fixed in the next step.
//
// music_player_provider.dart also has globalAudioHandler.attachRepository()
// call (in Android branch) — this is also intact, because that call will only
// be effective when main.dart's bootstrap is correctly set; without bootstrap
// globalAudioHandler will be null and that branch itself does a null-check
// and gracefully skips (won't crash), just Android background audio
// notification won't be active until bootstrap is fixed.

void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  ErrorHandler.init();

  if (!kIsWeb) {
    MediaKit.ensureInitialized();
  }

  await EnvConfig.load();

  await Supabase.initialize(
    url: EnvConfig.supabaseUrl,
    anonKey: EnvConfig.supabaseAnonKey,
  );

  runApp(
    const ProviderScope(
      child: TeloPlayApp(),
    ),
  );
}

class TeloPlayApp extends ConsumerWidget {
  const TeloPlayApp({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final router = ref.watch(appRouterProvider);

    return MaterialApp.router(
      title: 'TeloPlay',
      debugShowCheckedModeBanner: false,
      theme: AppTheme.dark,
      routerConfig: router,
    );
  }
}