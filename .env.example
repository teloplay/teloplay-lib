# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Third-Party Metadata APIs
DEEZER_APP_ID=
DEEZER_SECRET=
LASTFM_API_KEY=your-lastfm-api-key

# MusicBrainz User-Agent Info
MUSICBRAINZ_APP_NAME=TeloPlay
MUSICBRAINZ_APP_VERSION=1.0.0
MUSICBRAINZ_CONTACT_EMAIL=your-email@example.com

# TeloPlay Stream Service (Cloudflare Worker)
TELOPLAY_STREAM_PROXY_URL=https://your-worker-service.workers.dev
